# Copy to .env and provide your OWN secrets. Never commit .env.
TELEGRAM_BOT_TOKEN=PASTE_YOUR_NEW_BOT_TOKEN_HERE
# Comma-separated allowlist. Examples below are fictional.
TELEGRAM_USER_IDS=1111111111,2222222222,3333333333
# Access to /control (same or a subset of TELEGRAM_USER_IDS)
TELEGRAM_CONTROL_IDS=
CONFIG_FILE=config.yaml

# Optional Aeza integration. A key with management rights is needed for reboot.
AEZA_API_KEY=
AEZA_API_BASE=https://my.aeza.net/api/v2
AEZA_SERVICE_ID=
# Default disabled. Enable only after reviewing security and API rights.
AEZA_ALLOW_REBOOT=0
